{
  "name": "ts-quality-gates-starter",
  "version": "1.1.0-dev",
  "private": true,
  "description": "A small, strict TypeScript starter with executable quality gates",
  "type": "module",
  "license": "MIT",
  "author": "Tsutomu",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "depcruise": "depcruise --config dependency-cruiser.cjs src --output-type err",
    "test:quality": "node --test test/policy-rules.test.mjs test/dependency-policy.test.mjs test/gate-config.test.mjs",
    "evals": "node tools/run-evals.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "hooks:install": "node tools/install-hooks.mjs",
    "instantiate": "node tools/instantiate.mjs",
    "verify:template": "node tools/verify-template.mjs",
    "check": "npm run build && npm run typecheck && npm run lint && npm run depcruise && npm run test:quality && npm run test:profiles && npm run evals && npm run format:check",
    "test:profiles": "node --test test/profiles.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
